{
  "name": "tunebox",
  "productName": "YouTube Music",
  "version": "1.1.6",
  "description": "Ad-free YouTube Music desktop app with SponsorBlock and Discord Rich Presence",
  "main": "src/main.js",
  "author": "Personal build",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "repository": "https://github.com/KingCreeper531/youtube-music-desktop",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11",
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.tunebox.ytmusic",
    "productName": "YouTube Music",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KingCreeper531",
        "repo": "youtube-music-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "YouTube-Music-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "YouTube-Music-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Music",
      "runAfterFinish": true
    }
  }
}
